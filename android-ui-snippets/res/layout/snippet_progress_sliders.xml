<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     PROGRESS BARS, SLIDERS & CIRCULAR PROGRESS
     ============================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_cream">

    <!-- ===== Linear Progress Bars ===== -->

    <!-- Green progress bar -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressGreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="65"
        app:trackThickness="8dp"
        app:trackCornerRadius="4dp"
        app:indicatorColor="@color/green_primary"
        app:trackColor="@color/green_light"
        android:layout_marginBottom="16dp" />

    <!-- Blue progress bar -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBlue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="45"
        app:trackThickness="8dp"
        app:trackCornerRadius="4dp"
        app:indicatorColor="@color/blue_primary"
        app:trackColor="@color/blue_light"
        android:layout_marginBottom="16dp" />

    <!-- ===== Slider / SeekBar ===== -->

    <!-- Blue slider with thumb -->
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderBlue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:value="50"
        app:thumbColor="@color/blue_primary"
        app:trackColorActive="@color/blue_primary"
        app:trackColorInactive="@color/blue_light"
        app:thumbRadius="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Thin slider -->
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderThin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:value="30"
        app:thumbColor="@color/blue_primary"
        app:trackColorActive="@color/blue_primary"
        app:trackColorInactive="@color/blue_light"
        app:trackHeight="4dp"
        app:thumbRadius="8dp"
        android:layout_marginBottom="24dp" />

    <!-- Full-width dark blue progress bar -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressDarkBlue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="85"
        app:trackThickness="12dp"
        app:trackCornerRadius="6dp"
        app:indicatorColor="@color/blue_dark"
        app:trackColor="@color/divider"
        android:layout_marginBottom="24dp" />

    <!-- ===== Circular Progress (75%) ===== -->
    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/circularProgress"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:progress="75"
            app:trackThickness="8dp"
            app:indicatorColor="@color/blue_primary"
            app:trackColor="@color/divider"
            app:indicatorSize="100dp" />

        <TextView
            android:id="@+id/tvProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="75%"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />
    </FrameLayout>

    <!-- ===== Small loading spinners ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminate="true"
            app:trackThickness="3dp"
            app:indicatorColor="@color/green_primary"
            app:trackColor="@color/green_light"
            android:layout_margin="8dp" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminate="true"
            app:trackThickness="3dp"
            app:indicatorColor="@color/blue_primary"
            app:trackColor="@color/blue_light"
            android:layout_margin="8dp" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminate="true"
            app:trackThickness="3dp"
            app:indicatorColor="@color/purple_primary"
            app:trackColor="@color/purple_light"
            android:layout_margin="8dp" />
    </LinearLayout>

</LinearLayout>
