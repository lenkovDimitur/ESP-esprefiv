<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     ALL BUTTON VARIANTS - Renders every button from the UI kit
     Requires: com.google.android.material:material:1.11.0
     ============================================================ -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0EB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ═══════════ SECTION: Filled Gradient Buttons ═══════════ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filled Gradient"
            android:textSize="13sp"
            android:textColor="#636E72"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginBottom="10dp" />

        <!-- GET STARTED - blue gradient with rocket icon -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetStartedBlue"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="GET STARTED"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@null"
            android:background="@drawable/bg_button_gradient_blue"
            android:textColor="#FFFFFF"
            app:icon="@drawable/ic_rocket"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="25dp"
            android:paddingStart="24dp"
            android:paddingEnd="28dp"
            android:layout_marginBottom="8dp" />

        <!-- LOGIN - orange gradient -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoginOrange"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="LOGIN"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@null"
            android:background="@drawable/bg_button_gradient_orange"
            android:textColor="#FFFFFF"
            app:cornerRadius="25dp"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:layout_marginBottom="8dp" />

        <!-- SIGN UP - purple gradient -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignUpPurple"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="SIGN UP"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@null"
            android:background="@drawable/bg_button_gradient_purple"
            android:textColor="#FFFFFF"
            app:cornerRadius="25dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:layout_marginBottom="8dp" />

        <!-- CONTINUE - solid green with cart icon -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueGreen"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="CONTINUE"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="#5EBD9B"
            android:textColor="#FFFFFF"
            app:icon="@drawable/ic_cart"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="25dp"
            android:paddingStart="24dp"
            android:paddingEnd="28dp"
            android:layout_marginBottom="8dp" />

        <!-- Explore > purple filled -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExplorePurple"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="Explore"
            android:textSize="14sp"
            app:backgroundTint="#7B6BA8"
            android:textColor="#FFFFFF"
            app:icon="@drawable/ic_chevron_right"
            app:iconTint="#FFFFFF"
            app:iconGravity="end"
            app:iconPadding="4dp"
            app:cornerRadius="23dp"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Explore > green filled -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExploreGreen"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="Explore  >"
            android:textSize="14sp"
            app:backgroundTint="#5EBD9B"
            android:textColor="#FFFFFF"
            app:cornerRadius="23dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginBottom="8dp" />

        <!-- Shop Now - orange filled -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShopNow"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="Shop Now"
            android:textSize="14sp"
            app:backgroundTint="#E8895C"
            android:textColor="#FFFFFF"
            app:cornerRadius="23dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginBottom="20dp" />

        <!-- ═══════════ SECTION: Outlined Buttons ═══════════ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Outlined"
            android:textSize="13sp"
            android:textColor="#636E72"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginBottom="10dp" />

        <!-- GET STARTED - outlined green with Google icon -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetStartedGoogle"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="GET STARTED"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#2D3436"
            app:strokeColor="#5EBD9B"
            app:strokeWidth="1.5dp"
            app:cornerRadius="25dp"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="8dp" />

        <!-- LOGIN - outlined blue -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoginOutlined"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="LOGIN"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#5B8DEF"
            app:strokeColor="#5B8DEF"
            app:strokeWidth="1.5dp"
            app:cornerRadius="25dp"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:layout_marginBottom="8dp" />

        <!-- SIGN UP - outlined orange -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignUpOrangeOutlined"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="SIGN UP"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#E8895C"
            app:strokeColor="#E8895C"
            app:strokeWidth="1.5dp"
            app:cornerRadius="25dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:layout_marginBottom="8dp" />

        <!-- CONTINUE - outlined dark with play icon -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinuePlay"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="CONTINUE"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#2D3436"
            app:strokeColor="#2D3436"
            app:strokeWidth="1.5dp"
            app:cornerRadius="25dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconTint="#2D3436"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            android:paddingStart="20dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="8dp" />

        <!-- CONTINUE - outlined dark with arrow icon -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueArrow"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="CONTINUE"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#2D3436"
            app:strokeColor="#2D3436"
            app:strokeWidth="1.5dp"
            app:cornerRadius="25dp"
            app:icon="@drawable/ic_arrow_forward"
            app:iconTint="#2D3436"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            android:paddingStart="20dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="8dp" />

        <!-- Explore - outlined green with toggle switch -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_button_outlined_green"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore"
                android:textColor="#5EBD9B"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchExplore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="#FFFFFF"
                app:trackTint="#A4DBC8" />
        </LinearLayout>

        <!-- ═══════════ SECTION: Small / Utility Buttons ═══════════ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Small / Utility"
            android:textSize="13sp"
            android:textColor="#636E72"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- GET - small light blue pill -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGet"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="GET"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#5B8DEF"
                app:backgroundTint="#D4E4FA"
                app:cornerRadius="20dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:layout_marginEnd="12dp" />

            <!-- CLOSE - small coral/salmon pill -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="CLOSE"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                app:backgroundTint="#E07C7C"
                app:cornerRadius="20dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />
        </LinearLayout>

        <!-- ═══════════ SECTION: Icon Buttons (Circular) ═══════════ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Icon Buttons"
            android:textSize="13sp"
            android:textColor="#636E72"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp" />

        <!-- Row 1: Filled circle buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <!-- + blue -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_add"
                app:tint="#FFFFFF"
                app:backgroundTint="#5B8DEF" />

            <!-- Search purple -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_search"
                app:tint="#FFFFFF"
                app:backgroundTint="#7B6BA8" />

            <!-- Person orange -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabPerson"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_person"
                app:tint="#FFFFFF"
                app:backgroundTint="#E8895C" />

            <!-- + green -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAddGreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_add"
                app:tint="#FFFFFF"
                app:backgroundTint="#5EBD9B" />

            <!-- X red -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_close"
                app:tint="#FFFFFF"
                app:backgroundTint="#EF5350" />
        </LinearLayout>

        <!-- Row 2: Outlined circle buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_search"
                android:scaleType="center"
                android:contentDescription="Search"
                android:layout_marginEnd="12dp" />

            <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_person"
                android:scaleType="center"
                android:contentDescription="User"
                android:layout_marginEnd="12dp" />

            <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_circle"
                android:src="@drawable/ic_settings"
                android:scaleType="center"
                android:contentDescription="Settings"
                android:layout_marginEnd="12dp" />

            <!-- Bell with notification badge -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:fabSize="mini"
                    app:srcCompat="@drawable/ic_notification"
                    app:tint="#FFFFFF"
                    app:backgroundTint="#7B6BA8" />

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge_red"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-bold" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
